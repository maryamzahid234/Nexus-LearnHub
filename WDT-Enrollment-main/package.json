{
  "name": "mern-learning-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm.cmd install --workspaces",
    "dev": "concurrently \"npm.cmd run dev --workspace server\" \"npm.cmd run dev --workspace client\"",
    "server": "npm.cmd run dev --workspace server",
    "client": "npm.cmd run dev --workspace client",
    "build": "npm.cmd run build --workspace client",
    "seed:admin": "npm.cmd run seed:admin --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
